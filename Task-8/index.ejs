    <div class="benefit-list">
        <div class="benefit-item"><span>01</span><div><h3>Learn at your pace</h3><p>Take your time, explore new ideas, and learn in a way that works for you.</p></div></div>
       <div class="benefit-item"><span>02</span><div><h3>Explore new interests</h3><p>Discover different learning paths and find the skills to shape your future.</p></div></div>
        <div class="benefit-item"><span>03</span><div><h3>Build real-world skills</h3><p>Explore practical topics and prepare for new opportunities.</p></div></div>
    </div>
</section>

<section class="section" id="register">
    <div class="form-card">
        <span class="eyebrow">YOUR NEXT CHAPTER</span>
        <h2>Start learning today.</h2>
        <p class="form-intro">Register and take your first step with LearnSpace.</p>

        <form action="/submit" method="POST" onsubmit="return validateForm()">
            <label class="form-label" for="name">Full name</label>
            <input class="form-control" type="text" id="name" name="name" required>

            <label class="form-label" for="email">Email address</label>
            <input class="form-control" type="email" id="email" name="email" required>

            <label class="form-label" for="age">Age</label>
            <input class="form-control" type="number" id="age" name="age" min="16" max="100" required>

            <label class="form-label" for="course">Choose a course</label>
            <select class="form-select" id="course" name="course" required>
                <option value="">Select a course</option>
                <option value="Web Development">Web Development</option>
                <option value="UI/UX Design">UI/UX Design</option>
                <option value="Cyber Security">Cyber Security</option>
                <option value="Data Science">Data Science</option>
            </select>

<label class="form-label" for="password">Password</label>
<input class="form-control" type="password" id="password" name="password" minlength="8" required>
<p id="passwordStrength" aria-live="polite">Use at least 8 characters with uppercase, lowercase, number and symbol.</p>

<label class="form-label" for="confirmPassword">Confirm password</label>
<input class="form-control" type="password" id="confirmPassword" name="confirmPassword" required>
<p id="passwordMatch" aria-live="polite"></p>

<label class="form-label" for="bio">What do you want to learn? (optional)</label>
<textarea class="form-control" id="bio" name="bio" maxlength="150" rows="3"></textarea>
<p><span id="bioCount">0</span>/150 characters</p>

            <p id="error" role="alert"></p>
            <button type="submit" class="primary-button submit-button">Register Now ↗</button>
        </form>
    </div>
</section>

<footer class="footer">
    <div class="logo">LearnSpace<span>.</span></div>
    <p>Keep learning. Keep growing.</p>
    <span>© 2026 LearnSpace</span>
</footer>

<script>
const password = document.getElementById("password");
const confirmPassword = document.getElementById("confirmPassword");
const strengthText = document.getElementById("passwordStrength");
const matchText = document.getElementById("passwordMatch");
const bio = document.getElementById("bio");
const bioCount = document.getElementById("bioCount");
const error = document.getElementById("error");

function checkPasswordStrength() {
    const value = password.value;
    let score = 0;

    if (value.length >= 8) score++;
    if (/[A-Z]/.test(value)) score++;
    if (/[a-z]/.test(value)) score++;
    if (/[0-9]/.test(value)) score++;
    if (/[^A-Za-z0-9]/.test(value)) score++;

    const levels = ["Very weak", "Weak", "Fair", "Good", "Strong", "Strong"];
    strengthText.textContent = "Password strength: " + levels[score];
    checkPasswordMatch();
}

function checkPasswordMatch() {
    if (!confirmPassword.value) {
        matchText.textContent = "";
    } else if (password.value === confirmPassword.value) {
        matchText.textContent = "Passwords match!";
    } else {
        matchText.textContent = "Passwords do not match.";
    }
}

password.addEventListener("input", checkPasswordStrength);
confirmPassword.addEventListener("input", checkPasswordMatch);

bio.addEventListener("input", function () {
    bioCount.textContent = bio.value.length;
});

document.querySelector("form").addEventListener("submit", function (event) {
    const strongPassword =
        password.value.length >= 8 &&
        /[A-Z]/.test(password.value) &&
        /[a-z]/.test(password.value) &&
        /[0-9]/.test(password.value) &&
        /[^A-Za-z0-9]/.test(password.value);

    if (!strongPassword) {
        event.preventDefault();
        error.textContent =
            "Use at least 8 characters, including uppercase, lowercase, a number and a symbol.";
        password.focus();
        return;
    }

    if (password.value !== confirmPassword.value) {
        event.preventDefault();
        error.textContent = "Your passwords do not match.";
        confirmPassword.focus();
        return;
    }

    error.textContent = "";
});

const routeLinks = document.querySelectorAll(
    '.navbar a, .hero-actions a'
);

routeLinks.forEach(function (link) {
    link.addEventListener('click', function (event) {
        const target = link.getAttribute('href');

        if (!target || !target.startsWith('#')) return;

        const section = document.querySelector(target);

        if (section) {
            event.preventDefault();

            history.pushState(null, '', target);

            section.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }
    });
});

window.addEventListener('popstate', function () {
    const target = window.location.hash || '#home';
    const section = document.querySelector(target);

    if (section) {
        section.scrollIntoView({ behavior: 'smooth' });
    }
});

</script>

</body>
</html>